# SafePath Finder — Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with secure values.

# Application Settings
PROJECT_NAME="SafePath Finder Backend"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
# Generate a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./safepath.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://safepath_user:your_secure_password@localhost:5432/safepath_prod"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000"

# Governance & Data Retention Settings
DATA_RETENTION_DAYS=365
FRESHNESS_THRESHOLD_DAYS=30
OUTDATED_THRESHOLD_DAYS=90
AUTO_FLAG_KEYWORDS="harassment, assault, dark, broken, hazard"
REQUIRE_MODERATOR_APPROVAL=true

# Field-Level Encryption (AES-128 Fernet)
# Key must be a 32-byte url-safe base64-encoded key (e.g. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Stored separately from the database in a secret manager or secure environment variable.
FIELD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_FERNET_KEY"

# Outbound Mail Provider Configuration (for password reset and optional feedback notifications)
# Leave SMTP_HOST empty in development/test to use the simulated in-memory logger.
# Never commit real credentials to source control.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SafePath Notifications <no-reply@safepath.org>"
SMTP_TLS=true

# Frontend URL (used to generate password reset links)
FRONTEND_BASE_URL="http://localhost:8000"

# Study Area & Geospatial Configuration
# Named research study area or validated bounding box
STUDY_AREA_NAME="Bengaluru Pilot Corridor"
STUDY_AREA_BBOX_SOUTH=12.9200
STUDY_AREA_BBOX_WEST=77.5700
STUDY_AREA_BBOX_NORTH=12.9850
STUDY_AREA_BBOX_EAST=77.6200
# Optional place query (e.g. "Jayanagar, Bengaluru, India" - leave blank if using bbox)
STUDY_AREA_PLACE_NAME=""

# Geospatial Cache Directory
GEOSPATIAL_CACHE_DIR="./data/cache"

# Optional Crime Dataset CSV File Path (Leave blank if no verified crime dataset is supplied)
CRIME_DATA_FILE=""

# Routing Engine & Edge Cost Research Parameters
# Walking traversal speed in meters/second (1.2 m/s = 72 m/min)
WALKING_SPEED_MPS=1.2
# Penalty weight lambda for Balanced mode (Cost = T * (1 + lambda * R_effective))
ROUTING_LAMBDA_BALANCED=1.0
# Penalty weight lambda for Safety-prioritized mode (lambda_safety > lambda_balanced)
ROUTING_LAMBDA_SAFETY=3.0
# Prior assumption for unmapped evidence R_unknown in [0, 1]
ROUTING_DEFAULT_R_UNKNOWN=0.5
# Relative multi-criteria indicator weights (sum to 1.0)
ROUTING_WEIGHT_CRIME=0.35
ROUTING_WEIGHT_LIGHTING=0.30
ROUTING_WEIGHT_COMMUNITY=0.20
ROUTING_WEIGHT_ASSISTANCE=0.15
# Maximum detour multiplier over fastest duration
ROUTING_MAX_DETOUR_RATIO=1.6
# Minimum evidence coverage Q threshold below which a route is flagged as insufficient
ROUTING_MIN_COVERAGE_THRESHOLD=0.30
# Jaccard edge overlap threshold for Yen's algorithm alternative routes
ROUTING_ALTERNATIVE_OVERLAP_THRESHOLD=0.80
# Maximum alternative routes to return
ROUTING_MAX_ALTERNATIVES=3

# Geocoding & Location Search Configuration
# Selected provider: nominatim (OpenStreetMap Nominatim default)
GEOCODING_PROVIDER="nominatim"
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODING_USER_AGENT="SafePathFinder/1.0 (contact: safepath-research@safepath.org)"
# Optional private API key (kept strictly on backend; never exposed to frontend)
GEOCODING_API_KEY=""
GEOCODING_TIMEOUT_SECONDS=8.0
GEOCODING_CACHE_TTL_SECONDS=3600
GEOCODING_BOUND_TO_REGION=false


